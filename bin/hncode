#!/usr/bin/env node
// hncode CLI entry point. Explicitly runs main() — index.js's main is exported
// and invoked here with the real argv, avoiding fragile import.meta.url detection.
import('../src/index.js').then((mod) => {
  return mod.main(process.argv.slice(2)).then((code) => process.exit(code ?? 0));
}).catch((err) => {
  console.error(err);
  process.exit(1);
});