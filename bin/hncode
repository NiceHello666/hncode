#!/usr/bin/env node
// hncode CLI entry point.
//
// ORDER MATTERS HERE. bootstrap() installs the source-patch loader and loads
// plugins BEFORE index.js (and therefore agent.js / llm.js / tools) is imported.
// A module that is imported before the loader is installed cannot be patched, so
// the plugin step has to run first. See src/bootstrap.js for the details.
//
// bootstrap() never throws (a missing Node API or a broken plugin dir degrades
// to "no patches/plugins"), and we swallow even that here: nothing in the plugin
// subsystem may stop hncode itself from launching.
import('../src/bootstrap.js')
  .then((b) => b.bootstrap())
  .catch((err) => { console.error('[hncode] bootstrap failed, starting without plugins:', err); })
  .then(() => import('../src/index.js'))
  .then((mod) => mod.main(process.argv.slice(2)))
  .then((code) => process.exit(code ?? 0))
  .catch((err) => {
    console.error(err);
    process.exit(1);
  });

