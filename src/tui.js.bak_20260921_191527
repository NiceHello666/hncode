        }
      }
    }
    if (process.env.HNCODE_DEBUG && state.selection) {
      const _a = state.selection.anchor, _h = state.selection.head;
      const _s = (_h.row < _a.row || (_h.row === _a.row && _h.col < _a.col)) ? _h : _a;
      const _e = _s === _a ? _h : _a;
    }
