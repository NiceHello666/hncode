    const body = [col(f.title || '', C.cyan + C.bold), rule, ''];
    const fieldBodyRows = [];
    fields.forEach((field, i) => {
      const active = i === f.fieldIdx;
      const label = col((field.label + ':').padEnd(f.labelW + 1), active ? C.cyan : C.gray);
