        const mk = adjacentPasteMarker(cur, caret, -1);
        next = mk ? mk.start : Math.max(0, caret - 1);
      } else if (dirName === 'right') {
        const mk = adjacentPasteMarker(cur, caret, 1);
        next = mk ? mk.end : Math.min(cur.length, caret + 1);
      } else if (dirName === 'home') {
        next = 0;
      } else if (dirName === 'end') {
        next = cur.length;
