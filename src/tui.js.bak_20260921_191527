    fieldBodyRows.forEach((bi, i) => addHit(padTop + bi, 0, w - 1, { kind: 'formField', index: i }));
    if (typeBodyRow >= 0) {
      typeOpts.forEach((rec) => addHit(padTop + typeBodyRow, rec.colStart, rec.colEnd, { kind: 'formType', option: rec.opt }));
    }
