      if (state.mentionOpen && state.mentionList.length) {
        const n = state.mentionList.length;
        const cur = Math.min(state.mentionSel, n - 1);
        state.mentionSel = (cur + (t.key === 'wheeldown' ? 1 : n - 1)) % n;
